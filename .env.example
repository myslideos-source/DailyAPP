# dayli is fully usable without any of these — it falls back to a local
# demo dataset stored in this browser. Fill these in once you've created a
# Supabase project to switch the app over to real, synced, multi-device data.

# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: only needed for server-side/admin scripts (never expose to the
# client, never commit a real value).
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (real, background-capable reminder notifications). Generate a
# pair with `npx web-push generate-vapid-keys`. Only the PUBLIC key goes
# here — the private key belongs in Supabase Vault (see
# supabase/functions/send-due-reminders), never in this file or a client
# bundle.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
